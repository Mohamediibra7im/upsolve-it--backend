PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Mongo (use separate DBs for dev vs prod)
MONGODB_URI_DEV=mongodb://localhost:27017/training-tracker-dev
MONGODB_URI_PROD=mongodb://localhost:27017/training-tracker-prod
# Fallback (optional)
MONGODB_URI=mongodb://localhost:27017/training-tracker
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_EXPIRATION=7d

# Email (used by POST /api/contact)
SMTP_EMAIL=replace-me
SMTP_PASSWORD=replace-me
NOTIFICATION_EMAIL=replace-me

# Optional: used in contact email templates/links
APP_URL=http://localhost:3000

# Optional: if you later add Codeforces signed API calls
CODEFORCES_API_KEY=replace-me
CODEFORCES_API_SECRET=replace-me

